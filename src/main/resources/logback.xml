<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- AWS SDK: never log requests, responses, headers or wire data -->
  <logger name="software.amazon.awssdk" level="WARN" />
  <logger name="software.amazon.awssdk.request" level="WARN" />
  <logger name="org.apache.http.wire" level="WARN" />
  <logger name="org.apache.http.headers" level="WARN" />

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
