# Java / Maven build artifacts
target/
*.class

# Maven wrapper (never needed inside Docker)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (not used, but exclude for safety)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# Version control
.git/
.gitignore
.gitattributes
.github/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
LICENSE.md
CONTRIBUTING.md

# Test files
src/test/

# Docker files (avoid recursive copy)
Dockerfile
docker-compose.yml
.dockerignore

# Scripts directory (not needed in image)
scripts/

# Kubernetes manifests
kubernetes/

# Docs
docs/

# Log files
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
*~

# Node modules (if any frontend tooling)
node_modules/

# Build output (already excluded by target/)
build/
out/
